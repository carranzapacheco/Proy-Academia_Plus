# Imagen específica para Vercel Container Runtime.
# El Dockerfile original se conserva para Render.
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

# Copiar primero el pom permite reutilizar la caché de dependencias entre builds.
COPY pom.xml .
RUN mvn -B -Pvercel -DskipTests dependency:go-offline

COPY src ./src
RUN mvn -B -Pvercel -DskipTests clean package

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar

ENV SPRING_PROFILES_ACTIVE=vercel
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"

# Vercel inyecta PORT. Spring lo consume mediante server.port=${PORT:8084}.
EXPOSE 8080
CMD ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
